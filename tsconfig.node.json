{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "scripts"],
  // scripts/_investigate is gitignored one-off analysis, never committed and
  // never run by CI. Typechecking it means a fresh clone and a working copy
  // disagree about whether the project compiles, which is a confusing thing to
  // debug. It is excluded rather than fixed, because it is not part of the
  // repository.
  "exclude": ["scripts/_investigate"]
}
